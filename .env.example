# Carikos frontend environment variables.
# Copy this file to .env.local and fill in real values.

# Base URL of the backend API.
# ASSUMPTION: shape/structure to be confirmed with the backend developer (Tahap 5).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Map tiles come from OpenStreetMap and need no API key.
# Only add a key here if the team switches to a commercial tile provider.
# NEXT_PUBLIC_MAP_TILE_URL=
